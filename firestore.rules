rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      return request.auth != null && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }
    // A saved progress item: key, value (JSON text or null) and time. Values are capped so nobody can fill the database.
    function validItem() {
      let d = request.resource.data;
      return d.keys().hasOnly(['k', 'v', 't']) && d.k is string && d.k.size() <= 200 && d.t is int
        && (d.v == null || (d.v is string && d.v.size() <= 500000));
    }

    // Sync without an account: a secret 20-character code.
    match /sync/{code}/k/{item} {
      allow get, list: if code.matches('^[2-9A-HJ-NP-Z]{20}$');
      allow create, update: if code.matches('^[2-9A-HJ-NP-Z]{20}$') && validItem();
    }
    // Knight School accounts: only you can read or write your own progress.
    match /users/{uid}/k/{item} {
      allow get, list: if request.auth != null && request.auth.uid == uid;
      allow create, update: if request.auth != null && request.auth.uid == uid && validItem();
    }
    // Bug reports and ideas: anyone can send one; only the site owner (admins) can read or delete them.
    match /feedback/{id} {
      allow create: if request.resource.data.keys().hasOnly(['kind', 'msg', 'contact', 'page', 'ua', 'ver', 'user', 't'])
        && request.resource.data.kind in ['bug', 'idea', 'other']
        && request.resource.data.msg is string && request.resource.data.msg.size() > 0 && request.resource.data.msg.size() <= 2000
        && request.resource.data.contact.size() <= 200 && request.resource.data.page.size() <= 300
        && request.resource.data.ua.size() <= 400 && request.resource.data.ver.size() <= 40
        && request.resource.data.user.size() <= 40 && request.resource.data.t is int;
      allow read, delete: if isAdmin();
    }
    // Admin list: managed by hand in the Firebase console only.
    match /admins/{uid} {
      allow get: if request.auth != null && request.auth.uid == uid;
    }
  }
}
