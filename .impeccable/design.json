      "css": ".ds-card{background:var(--card,#312E2B);border-radius:10px;padding:1.1rem 1.25rem;color:var(--text,#fff);font:400 16px/1.5 \"Nunito Sans\",system-ui,sans-serif;max-width:420px}.ds-h{font-weight:800;font-size:1.08rem}.ds-row{display:grid;grid-template-columns:28px 1fr 40px auto;gap:.75rem;align-items:center;padding:.55rem 0;border-top:1px solid var(--line,#403C38)}.ds-h+.ds-row{border-top:0}.ds-row small{color:var(--text-3,#A19E9A)}.ds-res{display:grid;place-items:center;width:26px;height:26px;border-radius:6px;font-weight:800;font-size:.8rem}.ds-res.w{background:#81B64C;color:#13200A}.ds-res.l{background:#CA3431;color:#fff}.up{color:#95C45F;font-weight:800}.dn{color:#F2766F;font-weight:800}.ds-row a{color:#95C45F;font-weight:700;text-decoration:none}.ds-row a:hover{color:#fff;text-decoration:underline}"
