  "narrative": {
    "northStar": "The Club Room After Hours",
    "overview": "Knight School wears the category standard on purpose: the dark warm slate, left sidebar and bright green action that every serious chess site player already reads without thinking. The owner chose this canon over invented worlds, so the craft lives in execution, not novelty: tight card rhythm, tabular numbers, honest win/loss colour, one green button where the eye should go. It is personal rather than decorative; the screen is your real Elo, your games and Coach Knox's plan, nothing staged.\n\nDensity is medium-high, like a dashboard you check daily. Surfaces are flat tonal layers of one warm slate family; the only lift in the whole system is the green primary button's pressed-key bottom edge and the floating chat panel. Coach Knox speaks from a white paper bubble, the one light surface, so his voice reads as a person on a dark board.\n\nThe world refuses invented rank systems, belts, mascots-as-decoration and any copy of chess.com's name, logo or artwork. It borrows the category's grammar, never its brand.",
    "keyCharacteristics": [
      "Warm near-black slate in three tonal steps (ground, rail, card) with no borders between cards.",
      "One bright green primary per group, with a darker green bottom edge that depresses on press.",
      "Nunito Sans at 700 to 800 for anything you scan; tabular numerals everywhere.",
      "Result states as colour: win green, loss red, draw grey, in small square badges.",
      "The classic green and cream board with a yellow last-move tint.",
      "Lucide line icons only; chess notation (!!, ??, ?!) is text."
    ],
    "rules": [
      {
        "name": "The One Green Rule",
        "body": "Each group (a card, a plan list, a dialog) has at most one green primary button. In Today's plan only the first open item's Start is green; the rest are slate.",
        "section": "colors"
      },
      {
        "name": "The Result Means It Rule",
        "body": "Green, red and grey are reserved for win, loss and draw (and the matching move grades). Never use loss red for decoration or green for a non-action.",
        "section": "colors"
      },
      {
        "name": "The Weight Not Size Rule",
        "body": "Row titles and buttons are 700; headings and numbers are 800. Hierarchy inside a card comes from weight and grey level, not from new sizes.",
        "section": "typography"
      },
      {
        "name": "The Only Lift Rule",
        "body": "Nothing else gets a shadow. A new card that wants to stand out gets the green-edge outline (1px #45753C) like the sign-in card, not elevation.",
        "section": "elevation"
      }
    ],
    "dos": [
      "Do keep one green primary per group; every other button in that group is Slate Raise or a link.",
      "Do put dark ink (#13200A) on green fills and use Loss Text (#F2766F), not Loss Red, for red text on slate.",
      "Do use Lucide inline SVG icons at 1.15em with a 2px round stroke.",
      "Do write chess notation (!!, !, ?!, ?, ??) as text, and give each grade badge its own ink colour for contrast.",
      "Do disable hover fills on touch screens under `(hover: none)` so no fill stays stuck after a tap.",
      "Do step surfaces by tone (rail, ground, card, raise) instead of adding borders or shadows."
    ],
    "donts": [
      "Don't copy chess.com's name, logo or any of its assets; the category look is shared, the brand is not.",
      "Don't use emoji or Unicode glyphs as icons.",
      "Don't invent rank systems, belts or decorative worlds; ratings are the player's real chess.com Elo.",
      "Don't add shadows beyond the primary key edge and the floating chat panel.",
      "Don't use green, red or grey for anything that is not an action or a win, loss or draw."
    ]
  }
}
